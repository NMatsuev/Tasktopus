<%- include('../partials/header', { title }) %>

<h1>Изменить задачу</h1>

<% if (errors && errors.length) { %>
  <div class="flash flash-err">
    <ul><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul>
  </div>
<% } %>

<form method="POST" action="/tasks/<%= taskId %>" class="task-form">
  <input type="hidden" name="_method" value="PUT">

  <label for="title">Название *</label>
  <input type="text" id="title" name="title" value="<%= values.title %>" maxlength="200" required autofocus>

  <label for="description">Описание</label>
  <textarea id="description" name="description" rows="4"><%= values.description || '' %></textarea>

  <label for="status">Статус</label>
  <select id="status" name="status">
    <% statuses.forEach((s) => { %>
      <option value="<%= s.value %>" <%= values.status === s.value ? 'selected' : '' %>><%= s.label %></option>
    <% }) %>
  </select>

  <label for="due_date">Срок выполнения</label>
  <input type="date" id="due_date" name="due_date" value="<%= values.due_date || '' %>">

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a href="/tasks/<%= taskId %>" class="btn-text">Отмена</a>
  </div>
</form>

<%- include('../partials/footer') %>
